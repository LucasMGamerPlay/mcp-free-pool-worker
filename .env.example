# Copy to .env and fill in what you have. Providers without a key are skipped.

# Groq (priority 1)
GROQ_API_KEY=
# GROQ_API_KEYS=key1,key2

# Cerebras (priority 2)
CEREBRAS_API_KEY=

# Google AI Studio (priority 3)
GOOGLE_API_KEY=

# OpenRouter free models (priority 4)
OPENROUTER_API_KEY=

# GitHub Models (priority 5)
GITHUB_TOKEN=

# Optional: root used to resolve context_files / output_file_path (default: current directory)
# WORKSPACE_ROOT=

# Optional: alternate provider config file
# FREE_POOL_CONFIG=

# Optional: pool state cache (cooldowns survive restarts). Default: ~/.cache/mcp-free-pool/state.json
# FREE_POOL_STATE=
